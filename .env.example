# ── Aetheria environment configuration ──────────────────────────────
# Copy this file to .env.local and fill in your values.

# ── AI provider ──────────────────────────────────────────────────────
# Pick ONE (or several) provider keys. The first one present is used.
# OpenRouter (recommended — routes to many models with one key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (direct)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (direct)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Model routing ────────────────────────────────────────────────────
# MAIN_MODEL=openai/gpt-4o-mini        # main story model
# MEMORY_MODEL=openai/gpt-4o-mini      # cheap model for memory extraction
# SUMMARY_MODEL=openai/gpt-4o-mini     # cheap model for summarization
# EMBED_MODEL=openai/text-embedding-3-small  # embeddings (optional)

# ── Database ─────────────────────────────────────────────────────────
# Defaults to SQLite at ./data/aetheria.db. Point to a Postgres DSN to
# use Postgres instead (not yet wired in this build).
# DATABASE_PATH=./data/aetheria.db

# ── Points / monetization ────────────────────────────────────────────
# Daily free points granted per user (claim on /points), and the cost of
# each AI message (send, regenerate, swipe). Commands like /roll are free.
# DAILY_POINTS=500
# MESSAGE_COST=50

# ── App ──────────────────────────────────────────────────────────────
# NODE_ENV=development
